# =============================================================================
# HTTPS CONFIGURATION - Sissibol with DuckDNS + Let's Encrypt
# =============================================================================
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit the .env file to version control!
# =============================================================================

# =============================================================================
# DUCKDNS CONFIGURATION (Required)
# =============================================================================
# Create a free account at https://www.duckdns.org
# Your DuckDNS subdomain (e.g., if your domain is myapp.duckdns.org, enter "myapp")
DUCKDNS_SUBDOMAIN=your-subdomain

# Your DuckDNS token (found on your DuckDNS dashboard)
DUCKDNS_TOKEN=your-duckdns-token-here

# =============================================================================
# SSL CERTIFICATE CONFIGURATION (Required)
# =============================================================================
# Email for Let's Encrypt certificate notifications
# You will receive expiry warnings at this email
CERT_EMAIL=your-email@example.com

# =============================================================================
# DATABASE CONFIGURATION (Required)
# =============================================================================
# PostgreSQL database name
POSTGRES_DB=sissibol

# PostgreSQL username
POSTGRES_USER=sissibol_user

# PostgreSQL password - CHANGE THIS TO A STRONG PASSWORD!
# Use a password generator: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# =============================================================================
# BACKEND SECURITY (Required)
# =============================================================================
# JWT secret key - MUST be changed for production!
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_TO_A_STRONG_SECRET_KEY

# JWT token expiration time
JWT_EXPIRATION=24h

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================
# Node environment
NODE_ENV=production

# Frontend API URL (leave as /api for nginx proxy)
VITE_API_URL=/api

# =============================================================================
# SECURITY CHECKLIST
# =============================================================================
# Before deploying, ensure you have:
# [ ] Changed POSTGRES_PASSWORD to a strong password
# [ ] Changed JWT_SECRET to a random 64+ character string
# [ ] Set your actual DUCKDNS_SUBDOMAIN
# [ ] Set your actual DUCKDNS_TOKEN
# [ ] Set a valid CERT_EMAIL for certificate notifications
# [ ] Configured your router to forward port 443 to this machine
# [ ] Updated your DuckDNS domain to point to your public IP
# =============================================================================
