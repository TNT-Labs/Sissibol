# =============================================================================
# HTTPS CONFIGURATION - Sissibol with DuckDNS + Let's Encrypt
# =============================================================================
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit the .env file to version control!
# =============================================================================

# =============================================================================
# DUCKDNS CONFIGURATION (Required)
# =============================================================================
# Create a free account at https://www.duckdns.org
# Your DuckDNS subdomain (e.g., if your domain is myapp.duckdns.org, enter "myapp")
DUCKDNS_SUBDOMAIN=your-subdomain

# Your DuckDNS token (found on your DuckDNS dashboard)
DUCKDNS_TOKEN=your-duckdns-token-here

# =============================================================================
# SSL CERTIFICATE CONFIGURATION (Required)
# =============================================================================
# Email for Let's Encrypt certificate notifications
# You will receive expiry warnings at this email
CERT_EMAIL=your-email@example.com

# =============================================================================
# DATABASE CONFIGURATION (Required)
# =============================================================================
# PostgreSQL database name
POSTGRES_DB=sissibol

# PostgreSQL username
POSTGRES_USER=sissibol_user

# PostgreSQL password - CHANGE THIS TO A STRONG PASSWORD!
# Use a password generator: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# =============================================================================
# BACKEND SECURITY (Required)
# =============================================================================
# JWT secret key - MUST be changed for production!
# At least 32 characters, or the backend refuses to start.
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_STRONG_SECRET_KEY

# Initial administrator password (admin@sissibol.it), at least 12 characters
# (temporary: it must be replaced with a personal password at first login).
# If empty a random one is generated: see it with
#   make admin-password COMPOSE=docker-compose.https.yml
ADMIN_PASSWORD_INIZIALE=

# =============================================================================
# BACKUP (see BACKUP.md)
# =============================================================================
# Daily database + receipts backup into ./backups, verified before being kept.
# Copy ./backups to another disk or place regularly: a backup on the same
# machine does not survive a disk failure or a theft.
BACKUP_ORA=02:30
BACKUP_GIORNI=14
BACKUP_MESI=12

# =============================================================================
# CORS CONFIGURATION (Required for security)
# =============================================================================
# Comma-separated list of additional allowed origins. The site's own origin
# (the DuckDNS domain served by nginx) is always allowed.
CORS_ORIGINS=https://your-subdomain.duckdns.org

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================
# Node environment
NODE_ENV=production

# Frontend API URL (leave as /api for nginx proxy)
VITE_API_URL=/api

# =============================================================================
# EMAIL (Optional) - see AVVISI.md
# =============================================================================
# Without SMTP_HOST and a sender (SMTP_FROM or SMTP_USER) no email is sent.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=avvisi@example.com
# SMTP_PASS=
# SMTP_FROM="Studio Rossi <avvisi@example.com>"
# APP_FUSO_ORARIO=Europe/Rome
# Daily internal summary to the studio
# NOTIFICHE_EMAIL_TO=ufficio@example.com
# NOTIFICHE_ORA=07:00
# Deadline notices to clients: keep automatic sending off until a manual test
# from the Avvisi page has been checked.
# AVVISI_INVIO_AUTOMATICO=false
# AVVISI_ORA=09:00
# AVVISI_FIRMA="Studio Rossi - Pratiche auto\nTel. 02 1234567"
# AVVISI_RISPONDI_A=info@example.com

# =============================================================================
# SECURITY CHECKLIST
# =============================================================================
# Before deploying, ensure you have:
# [ ] Changed POSTGRES_PASSWORD to a strong password
# [ ] Changed JWT_SECRET to a random 64+ character string
# [ ] Set CORS_ORIGINS to your actual domain (https://your-subdomain.duckdns.org)
# [ ] Set your actual DUCKDNS_SUBDOMAIN
# [ ] Set your actual DUCKDNS_TOKEN
# [ ] Set a valid CERT_EMAIL for certificate notifications
# [ ] Configured your router to forward port 443 to this machine
# [ ] Checked the first backup: make backup-stato COMPOSE=docker-compose.https.yml
# [ ] Planned a regular copy of ./backups off this machine
# [ ] Updated your DuckDNS domain to point to your public IP
# =============================================================================
