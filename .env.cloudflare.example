# =============================================================================
# Sissibol dietro Cloudflare Tunnel (docker-compose.cloudflare.yml)
# =============================================================================
# Copiare in .env e compilare. Il file .env contiene credenziali: non va mai
# condiviso né messo sotto controllo di versione. Guida: CLOUDFLARE.md
# =============================================================================

# Dominio pubblico: l'applicazione risponde su https://<APP_DOMINIO>/bolli
# (es. shopbeautylab.it, oppure un sottodominio dedicato come
# gestione.shopbeautylab.it, più sicuro: vedi CLOUDFLARE.md).
APP_DOMINIO=shopbeautylab.it

# Token del tunnel: Zero Trust > Networks > Tunnels > (tunnel) > il valore dopo
# "--token" nel comando di installazione. Chi lo possiede può impersonare il
# tunnel: trattarlo come una password.
TUNNEL_TOKEN=

# Solo con il Worker (dominio principale già occupato da un altro sito):
# lo stesso valore del secret SEGRETO_ORIGINE del Worker.
# Generarlo con:  openssl rand -hex 32
# Vuoto = accesso diretto dal tunnel, senza Worker.
ORIGINE_SEGRETO=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
POSTGRES_DB=sissibol
POSTGRES_USER=sissibol_user
# Generarla con:  openssl rand -base64 32
POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# Sicurezza del backend
# -----------------------------------------------------------------------------
# Firma dei token: almeno 32 caratteri casuali, altrimenti il backend non parte.
# Generarla con:  openssl rand -base64 48
JWT_SECRET=

# Password provvisoria del primo amministratore (admin@sissibol.it), almeno 12
# caratteri. Al primo accesso l'applicazione impone di sceglierne una personale.
# Se vuota se ne genera una casuale:
#   make admin-password COMPOSE=docker-compose.cloudflare.yml
ADMIN_PASSWORD_INIZIALE=

# -----------------------------------------------------------------------------
# Backup (vedi BACKUP.md)
# -----------------------------------------------------------------------------
BACKUP_ORA=02:30
BACKUP_GIORNI=14
BACKUP_MESI=12
APP_FUSO_ORARIO=Europe/Rome

# -----------------------------------------------------------------------------
# Posta (facoltativa, vedi AVVISI.md)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFICHE_EMAIL_TO=
NOTIFICHE_GIORNI_ANTICIPO=30
NOTIFICHE_ORA=07:00
AVVISI_INVIO_AUTOMATICO=false
AVVISI_ORA=09:00
AVVISI_MAX_EMAIL_PER_ESECUZIONE=200
AVVISI_FIRMA=
AVVISI_RISPONDI_A=
