{
  "name": "sissibol-monorepo",
  "version": "1.0.0",
  "description": "PWA Gestione Scadenziario Bolli per Autotrasporto",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run start:dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
