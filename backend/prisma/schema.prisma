// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Utente {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  ruolo     Ruolo    @default(OPERATORE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("utenti")
}

enum Ruolo {
  ADMIN
  OPERATORE
}

enum TipoCliente {
  PERSONA_FISICA
  PERSONA_GIURIDICA
}

model Cliente {
  id              Int          @id @default(autoincrement())
  tipoCliente     TipoCliente  @default(PERSONA_GIURIDICA) @map("tipo_cliente")
  // Campi per Persona Giuridica
  ragioneSociale  String?      @map("ragione_sociale")
  partitaIva      String?      @map("partita_iva")
  // Campi per Persona Fisica
  nome            String?
  cognome         String?
  codiceFiscale   String?      @map("codice_fiscale")
  // Campi comuni
  indirizzo       String?
  email           String?
  telefono        String?
  note            String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  veicoli         Veicolo[]

  @@map("clienti")
}

model Veicolo {
  id                    Int       @id @default(autoincrement())
  idCliente             Int       @map("id_cliente")
  targa                 String
  tipoVeicolo           String?   @map("tipo_veicolo")
  classeAmbientale      String?   @map("classe_ambientale")
  regione               String?
  // Nuovi campi per calcolo bollo (tariffario Lombardia 2026)
  alimentazione         String?                           // Benzina, Diesel, GPL, Metano, Elettrico, etc.
  potenzaKw             Decimal?  @map("potenza_kw") @db.Decimal(10, 2)  // Potenza in KW
  cilindrata            Int?                              // Cilindrata in cc (per motocarri/motofurgoni)
  portataKg             Int?      @map("portata_kg")      // Portata in KG (autocarri < 12 ton)
  pesoComplessivoKg     Int?      @map("peso_complessivo_kg") // Peso complessivo (determina categoria autocarro)
  numeroAssi            Int?      @map("numero_assi")     // Numero assi (autocarri >= 12 ton)
  tipoSospensione       String?   @map("tipo_sospensione") // Pneumatiche o non pneumatiche
  numeroPosti           Int?      @map("numero_posti")    // Per rimorchi trasporto persone
  massaRimorchiabileKg  Int?      @map("massa_rimorchiabile_kg") // Tassa aggiuntiva trattori stradali
  dataImmatricolazione  DateTime? @map("data_immatricolazione") @db.Date // Per calcolo ultratrentennali
  note                  String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  cliente               Cliente   @relation(fields: [idCliente], references: [id], onDelete: Cascade)
  scadenze              Scadenza[]

  @@map("veicoli")
}

model Scadenza {
  id              Int       @id @default(autoincrement())
  idVeicolo       Int       @map("id_veicolo")
  meseScadenza    Int       @map("mese_scadenza")  // 1-12
  annoScadenza    Int       @map("anno_scadenza")
  periodicita     Periodicita @default(ANNUALE)
  importoPrevisto Decimal?  @map("importo_previsto") @db.Decimal(10, 2)
  stato           StatoScadenza @default(DA_PAGARE)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  veicolo         Veicolo   @relation(fields: [idVeicolo], references: [id], onDelete: Cascade)
  pagamenti       Pagamento[]

  @@map("scadenze")
}

enum StatoScadenza {
  DA_PAGARE
  PAGATO
  SCADUTO
}

enum Periodicita {
  QUADRIMESTRALE
  ANNUALE
}

model Pagamento {
  id                Int       @id @default(autoincrement())
  idScadenza        Int       @map("id_scadenza")
  dataPagamento     DateTime  @map("data_pagamento") @db.Date
  importoPagato     Decimal   @map("importo_pagato") @db.Decimal(10, 2)
  metodoPagamento   String?   @map("metodo_pagamento")
  ricevutaFile      String?   @map("ricevuta_file")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  scadenza          Scadenza  @relation(fields: [idScadenza], references: [id], onDelete: Cascade)

  @@map("pagamenti")
}

// =====================================================
// CONFIGURAZIONE TARIFFE BOLLO
// =====================================================

// Configurazione generale per anno/regione
model ConfigurazioneBollo {
  id                    Int       @id @default(autoincrement())
  annoValidita          Int       @map("anno_validita")
  regione               String    // "Lombardia", "Piemonte", etc. o "DEFAULT" per tariffa nazionale
  scontoRid             Decimal   @map("sconto_rid") @db.Decimal(5, 2) @default(0) // Sconto domiciliazione bancaria (es. 15%)
  attivo                Boolean   @default(true)
  note                  String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tariffe               TariffaBollo[]

  @@unique([annoValidita, regione])
  @@map("configurazioni_bollo")
}

// Tariffe specifiche per tipo veicolo
model TariffaBollo {
  id                    Int       @id @default(autoincrement())
  idConfigurazione      Int       @map("id_configurazione")

  // Criteri di applicabilità
  tipoVeicolo           String    @map("tipo_veicolo")           // Autovettura, Motociclo, Autocarro, etc.
  categoriaEuro         String?   @map("categoria_euro")         // Euro 0, Euro 1, Euro 2, Euro 3, Euro 4-5-6, etc.

  // Soglie (per tariffe a scaglioni)
  unitaMisura           String    @map("unita_misura")           // KW, CC, KG, POSTI, ASSI, FISSO
  sogliaMin             Decimal?  @map("soglia_min") @db.Decimal(10, 2) // Valore minimo (incluso)
  sogliaMax             Decimal?  @map("soglia_max") @db.Decimal(10, 2) // Valore massimo (escluso), null = illimitato

  // Importi
  importoUnitario       Decimal   @map("importo_unitario") @db.Decimal(10, 4) // Importo per unità (es. €/KW)
  importoFisso          Decimal?  @map("importo_fisso") @db.Decimal(10, 2)    // Importo fisso aggiuntivo

  // Condizioni aggiuntive
  tipoSospensione       String?   @map("tipo_sospensione")       // Per autocarri: Pneumatiche, Non pneumatiche
  periodicita           String    @default("ANNUALE")            // ANNUALE, QUADRIMESTRALE

  // Metadata
  descrizione           String?
  ordine                Int       @default(0)                    // Ordine di valutazione (per priorità)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  configurazione        ConfigurazioneBollo @relation(fields: [idConfigurazione], references: [id], onDelete: Cascade)

  @@map("tariffe_bollo")
}

// Esenzioni e riduzioni
model EsenzioneBollo {
  id                    Int       @id @default(autoincrement())
  idConfigurazione      Int       @map("id_configurazione")

  // Tipo esenzione
  tipoEsenzione         String    @map("tipo_esenzione")         // TOTALE, PARZIALE
  percentualeRiduzione  Decimal?  @map("percentuale_riduzione") @db.Decimal(5, 2) // Per riduzioni parziali

  // Criteri di applicabilità
  tipoVeicolo           String?   @map("tipo_veicolo")
  alimentazione         String?                                  // Elettrico, GPL, Metano
  anniDaImmatricolazione Int?     @map("anni_da_immatricolazione") // Per ultratrentennali

  descrizione           String
  note                  String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("esenzioni_bollo")
}
