# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://sissibol_user:sissibol_password@postgres:5432/sissibol?schema=public"

# ============================================
# JWT (IMPORTANTE: cambiare in produzione!)
# ============================================
JWT_SECRET="change-this-secret-in-production"
JWT_EXPIRATION="24h"

# ============================================
# APP
# ============================================
PORT=3000
NODE_ENV="production"

# ============================================
# CORS (IMPORTANTE per sicurezza)
# ============================================
# Lista di origini permesse separate da virgola
# In Docker, usa l'URL del frontend container o del reverse proxy
CORS_ORIGINS="http://localhost:80,http://frontend:80"
