# Database
DATABASE_URL="postgresql://sissibol_user:sissibol_password@postgres:5432/sissibol?schema=public"

# JWT
JWT_SECRET="change-this-secret-in-production"
JWT_EXPIRATION="24h"

# App
PORT=3000
NODE_ENV="production"

# Email (opzionale per notifiche)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASSWORD="your-password"
SMTP_FROM="noreply@sissibol.com"

# File Upload
UPLOAD_PATH="./uploads"
MAX_FILE_SIZE=5242880
