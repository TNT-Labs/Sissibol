# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://user:password@localhost:5432/sissibol?schema=public"

# ============================================
# JWT (IMPORTANTE: cambiare in produzione!)
# ============================================
# Genera con: openssl rand -base64 64
JWT_SECRET="your-secret-key-change-in-production"
JWT_EXPIRATION="24h"

# ============================================
# APP
# ============================================
PORT=3000
NODE_ENV="development"

# ============================================
# CORS (IMPORTANTE per sicurezza)
# ============================================
# Lista di origini permesse separate da virgola
# Es: "http://localhost:5173,https://app.example.com"
# Se non specificato, usa default localhost:5173
CORS_ORIGINS="http://localhost:5173"

# ============================================
# NOTIFICHE EMAIL (opzionali)
# ============================================
# Se SMTP_HOST non è impostato le notifiche sono disabilitate.
# Ogni giorno all'ora indicata viene inviato un riepilogo delle scadenze
# imminenti ai destinatari (default: tutti gli utenti ADMIN).
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="notifiche@example.com"
# SMTP_PASS="password"
# SMTP_FROM="Sissibol <notifiche@example.com>"
# NOTIFICHE_EMAIL_TO="admin@example.com,ufficio@example.com"
# NOTIFICHE_GIORNI_ANTICIPO=30
# NOTIFICHE_ORA="07:00"
