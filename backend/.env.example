# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://user:password@localhost:5432/sissibol?schema=public"

# ============================================
# JWT (IMPORTANTE: cambiare in produzione!)
# ============================================
# Genera con: openssl rand -base64 64
JWT_SECRET="your-secret-key-change-in-production"
JWT_EXPIRATION="24h"

# ============================================
# APP
# ============================================
PORT=3000
NODE_ENV="development"

# ============================================
# CORS (IMPORTANTE per sicurezza)
# ============================================
# Lista di origini permesse separate da virgola
# Es: "http://localhost:5173,https://app.example.com"
# Se non specificato, usa default localhost:5173
CORS_ORIGINS="http://localhost:5173"
