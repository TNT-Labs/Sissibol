# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://user:password@localhost:5432/sissibol?schema=public"

# ============================================
# JWT (IMPORTANTE: cambiare in produzione!)
# ============================================
# Genera con: openssl rand -base64 64
JWT_SECRET="your-secret-key-change-in-production"
JWT_EXPIRATION="24h"

# ============================================
# APP
# ============================================
PORT=3000
NODE_ENV="development"

# ============================================
# CORS (IMPORTANTE per sicurezza)
# ============================================
# Lista di origini permesse separate da virgola
# Es: "http://localhost:5173,https://app.example.com"
# Se non specificato, usa default localhost:5173
CORS_ORIGINS="http://localhost:5173"

# ============================================
# EMAIL (opzionali) - vedi AVVISI.md
# ============================================
# Senza SMTP_HOST e un mittente (SMTP_FROM o SMTP_USER) nessuna email parte.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="notifiche@example.com"
# SMTP_PASS="password"
# SMTP_FROM="Sissibol <notifiche@example.com>"

# Fuso orario degli orari qui sotto (default Europe/Rome)
# APP_FUSO_ORARIO="Europe/Rome"

# Riepilogo interno giornaliero delle scadenze imminenti allo studio
# (default destinatari: tutti gli utenti ADMIN).
# NOTIFICHE_EMAIL_TO="admin@example.com,ufficio@example.com"
# NOTIFICHE_GIORNI_ANTICIPO=30
# NOTIFICHE_ORA="07:00"

# Avvisi di scadenza ai clienti. L'invio automatico è spento di default:
# attivarlo significa scrivere ai clienti, va fatto dopo una prova manuale.
# AVVISI_INVIO_AUTOMATICO=false
# AVVISI_ORA="09:00"
# AVVISI_MAX_EMAIL_PER_ESECUZIONE=200
# AVVISI_FIRMA="Studio Rossi - Pratiche auto\nTel. 02 1234567"
# AVVISI_RISPONDI_A="info@example.com"
