# compiled output
/dist
/node_modules
tsconfig.tsbuildinfo

# Prisma: output compilato dai .ts presenti in prisma/ (es. seed-tariffe-*.ts).
# Gli script scritti a mano sono sorgenti e vanno versionati: senza queste
# eccezioni finirebbero esclusi in silenzio e l'immagine Docker partirebbe
# senza di loro.
prisma/*.js
prisma/*.d.ts
prisma/*.js.map
!prisma/seed.js
!prisma/import-mdb.js
!prisma/import-mapping.js

