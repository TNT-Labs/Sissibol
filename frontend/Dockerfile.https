# =============================================================================
# Frontend Dockerfile with HTTPS Support
# =============================================================================
# Multi-stage build for secure HTTPS deployment
# =============================================================================

# Build stage
FROM node:18-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install --legacy-peer-deps

# Copy source code
COPY . .

# Build arguments
ARG VITE_API_URL=/api
ARG DOMAIN_NAME=localhost
ENV VITE_API_URL=$VITE_API_URL

# Build application
RUN npm run build

# =============================================================================
# Production stage with nginx HTTPS
# =============================================================================
FROM nginx:alpine AS production

# Install envsubst for template processing
RUN apk add --no-cache gettext

# Domain name argument
ARG DOMAIN_NAME=localhost
ENV DOMAIN_NAME=$DOMAIN_NAME

# Remove default nginx config
RUN rm -f /etc/nginx/conf.d/default.conf

# Copy main nginx configuration
COPY nginx-main.conf /etc/nginx/nginx.conf

# Copy HTTPS server configuration as template
COPY nginx.https.conf /etc/nginx/templates/default.conf.template

# Copy built assets from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Create SSL directory
RUN mkdir -p /etc/nginx/ssl

# Create a startup script that processes templates
RUN cat > /docker-entrypoint.d/40-envsubst-on-templates.sh << 'EOF'
#!/bin/sh
set -e

# Process nginx template with environment variables
envsubst '${DOMAIN_NAME}' < /etc/nginx/templates/default.conf.template > /etc/nginx/conf.d/default.conf

echo "Nginx configuration generated for domain: $DOMAIN_NAME"
EOF

RUN chmod +x /docker-entrypoint.d/40-envsubst-on-templates.sh

# Create directory for templates
RUN mkdir -p /etc/nginx/templates

# Expose HTTPS port only
EXPOSE 443

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider --no-check-certificate https://localhost/health || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
