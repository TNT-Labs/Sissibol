# =============================================================================
# Frontend Dockerfile with HTTPS Support
# =============================================================================
# Multi-stage build for secure HTTPS deployment
# =============================================================================

# Build stage
# Contesto di build: la radice del monorepo, per installare dal package-lock.json
# con npm ci (build riproducibili).
# Node 22 LTS: Vite 7 e il plugin PWA richiedono Node >= 20, e Node 18 e 20
# sono fuori supporto. Deve coincidere con la versione usata dalla CI.
FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY backend/package.json backend/
COPY frontend/package.json frontend/
RUN npm ci --workspace=frontend

COPY frontend/ frontend/

# Build arguments
ARG VITE_API_URL=/api
ARG DOMAIN_NAME=localhost
ENV VITE_API_URL=$VITE_API_URL

WORKDIR /app/frontend
RUN npm run build

# =============================================================================
# Production stage with nginx HTTPS
# =============================================================================
FROM nginx:alpine AS production

# Install envsubst for template processing
RUN apk add --no-cache gettext

# Domain name argument
ARG DOMAIN_NAME=localhost
ENV DOMAIN_NAME=$DOMAIN_NAME

# Remove default nginx config
RUN rm -f /etc/nginx/conf.d/default.conf

# Copy main nginx configuration
COPY frontend/nginx-main.conf /etc/nginx/nginx.conf

# Copy HTTPS server configuration as template
COPY frontend/nginx.https.conf /etc/nginx/templates/default.conf.template

# Copy built assets from builder
COPY --from=builder /app/frontend/dist /usr/share/nginx/html

# Create SSL directory
RUN mkdir -p /etc/nginx/ssl

# Create a startup script that processes templates
RUN cat > /docker-entrypoint.d/40-envsubst-on-templates.sh << 'EOF'
#!/bin/sh
set -e

# Process nginx template with environment variables
envsubst '${DOMAIN_NAME}' < /etc/nginx/templates/default.conf.template > /etc/nginx/conf.d/default.conf

echo "Nginx configuration generated for domain: $DOMAIN_NAME"
EOF

RUN chmod +x /docker-entrypoint.d/40-envsubst-on-templates.sh

# Ricarica nginx quando certbot rinnova il certificato. Senza, nginx continua
# a servire il certificato caricato all'avvio fino alla sua scadenza.
# Il container certbot, a rinnovo avvenuto, tocca /etc/letsencrypt/renewal-complete.
RUN cat > /docker-entrypoint.d/50-ricarica-certificati.sh << 'EOF'
#!/bin/sh
SEGNALE=/etc/letsencrypt/renewal-complete
ULTIMA=/tmp/ultima-ricarica-certificati
touch "$ULTIMA"
(
  while :; do
    sleep 600
    if [ -f "$SEGNALE" ] && [ "$SEGNALE" -nt "$ULTIMA" ]; then
      touch "$ULTIMA"
      nginx -t 2>/dev/null && nginx -s reload && echo "Certificato rinnovato: nginx ricaricato"
    fi
  done
) &
EOF

RUN chmod +x /docker-entrypoint.d/50-ricarica-certificati.sh

# Create directory for templates
RUN mkdir -p /etc/nginx/templates

# Expose HTTPS port only
EXPOSE 443

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider --no-check-certificate https://localhost/health || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
