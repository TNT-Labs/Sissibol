# =============================================================================
# Frontend per Cloudflare Tunnel: interfaccia e API sotto /bolli
# =============================================================================
# Servito da cloudflared (docker-compose.cloudflare.yml), senza porte
# pubblicate: il TLS è gestito da Cloudflare. Vedi CLOUDFLARE.md.
# Contesto di build: la radice del monorepo.
# =============================================================================

FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY backend/package.json backend/
COPY frontend/package.json frontend/
RUN npm ci --workspace=frontend

COPY frontend/ frontend/

# L'applicazione vive sotto /bolli: percorsi dei file, router, service worker.
ENV VITE_BASE_PATH=/bolli/
ENV VITE_API_URL=/bolli/api

WORKDIR /app/frontend
RUN npm run build

# =============================================================================
FROM nginx:1.29-alpine AS production

# Configurazione del sito; il file incluso da nginx (conf.d/sissibol.conf) è
# generato all'avvio da 40-sissibol-origine.sh, che decide come riconoscere
# l'IP del client e se esigere il segreto del Worker (ORIGINE_SEGRETO).
RUN rm -f /etc/nginx/conf.d/default.conf
COPY frontend/nginx-tunnel/sito.conf frontend/nginx-tunnel/intestazioni.conf frontend/nginx-tunnel/proxy.conf /etc/nginx/sissibol/
COPY --chmod=755 frontend/nginx-tunnel/40-sissibol-origine.sh /docker-entrypoint.d/

COPY --from=builder /app/frontend/dist /usr/share/nginx/html/bolli

EXPOSE 8080

# Controllo di salute su una porta raggiungibile solo dall'interno del container.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8081/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
