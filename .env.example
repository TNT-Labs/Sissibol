# ============================================
# CONFIGURAZIONE DOCKER COMPOSE
# ============================================
# Questo file è un esempio di come configurare
# le variabili d'ambiente per Docker Compose.
# Copia questo file in .env e modifica i valori.

# Database PostgreSQL
POSTGRES_DB=sissibol
POSTGRES_USER=sissibol_user
POSTGRES_PASSWORD=sissibol_password

# Backend (NestJS)
JWT_SECRET=your-production-secret-key-change-me
JWT_EXPIRATION=24h
NODE_ENV=production

# Frontend (React)
VITE_API_URL=http://localhost:3000

# Porte
FRONTEND_PORT=80
BACKEND_PORT=3000
POSTGRES_PORT=5432

# ============================================
# NOTA: Non committare il file .env su Git!
# ============================================
