# ============================================
# CONFIGURAZIONE DOCKER COMPOSE (docker-compose.yml)
# ============================================
# Copiare questo file in .env e modificare i valori.
# Per l'installazione HTTPS usare .env.https.example.

# Database PostgreSQL (raggiungibile solo dai container e da questo computer)
POSTGRES_DB=sissibol
POSTGRES_USER=sissibol_user
POSTGRES_PASSWORD=sissibol_password

# Backend (NestJS)
# OBBLIGATORIA: firma dei token di accesso. Generarla con:
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION=24h

# Password del primo amministratore (admin@sissibol.it), almeno 8 caratteri.
# Se vuota se ne genera una casuale: vederla con  make admin-password
ADMIN_PASSWORD_INIZIALE=

# Origini esterne ammesse dal CORS, separate da virgola.
# La stessa origine dell'interfaccia (http://<server>) è sempre ammessa.
CORS_ORIGINS=

# Fuso orario degli orari pianificati (backup, avvisi, riepilogo)
APP_FUSO_ORARIO=Europe/Rome

# Backup (vedi BACKUP.md): ora del backup giornaliero e conservazione
BACKUP_ORA=02:30
BACKUP_GIORNI=14
BACKUP_MESI=12

# Email: vedi AVVISI.md per server di posta e avvisi ai clienti
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=avvisi@example.com
# SMTP_PASS=
# SMTP_FROM="Studio <avvisi@example.com>"

# ============================================
# NOTA: Non committare il file .env su Git!
# ============================================
